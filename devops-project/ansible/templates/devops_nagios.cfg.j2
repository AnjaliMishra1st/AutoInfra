# Generated by Ansible - Nagios configuration for the DevOps project

define timeperiod {
  timeperiod_name devops_24x7
  alias           24 Hours
  sunday          00:00-24:00
  monday          00:00-24:00
  tuesday         00:00-24:00
  wednesday       00:00-24:00
  thursday        00:00-24:00
  friday          00:00-24:00
  saturday        00:00-24:00
}

define contact {
  contact_name                  devopsadmin
  alias                         DevOps Admin
  host_notifications_enabled    1
  service_notifications_enabled 1
  host_notification_period      devops_24x7
  service_notification_period   devops_24x7
  host_notification_options     d,u,r
  service_notification_options  w,u,c,r
  host_notification_commands    notify-host-by-email
  service_notification_commands notify-service-by-email
  email                         admin@example.com
}

define contactgroup {
  contactgroup_name devops-admins
  alias             DevOps Admins
  members           devopsadmin
}

define command {
  command_name devops_ping
  command_line /usr/lib/nagios/plugins/check_ping -H $HOSTADDRESS$ -w 100.0,20% -c 500.0,60% -p 3
}
define command {
  command_name devops_http
  command_line /usr/lib/nagios/plugins/check_http -H $HOSTADDRESS$
}
define command {
  command_name devops_disk
  command_line /usr/lib/nagios/plugins/check_disk -w 20% -c 10% -p /
}
define command {
  command_name devops_load
  command_line /usr/lib/nagios/plugins/check_load -w 5,4,3 -c 10,8,6
}
define command {
  command_name devops_procs
  command_line /usr/lib/nagios/plugins/check_procs -C apache2 -c 1:
}

define host {
  name                  devops-host
  register              0
  check_command         devops_ping
  max_check_attempts    2
  check_interval        1
  retry_interval        1
  check_period          devops_24x7
  notification_interval 30
  notification_period   devops_24x7
  notification_options  d,r
  contact_groups        devops-admins
  notifications_enabled 1
}

define service {
  name                  devops-service
  register              0
  max_check_attempts    2
  check_interval        1
  retry_interval        1
  check_period          devops_24x7
  notification_interval 30
  notification_period   devops_24x7
  notification_options  w,u,c,r
  contact_groups        devops-admins
  notifications_enabled 1
  active_checks_enabled 1
  is_volatile           0
}

{% for h in groups['webservers'] %}
define host {
  use       devops-host
  host_name {{ h }}
  alias     Web server {{ h }}
  address   {{ hostvars[h].ip }}
}
{% endfor %}

define hostgroup {
  hostgroup_name devops-web
  alias          DevOps Web Servers
  members        {{ groups['webservers'] | join(',') }}
}

define service {
  use                 devops-service
  hostgroup_name      devops-web
  service_description PING
  check_command       devops_ping
}
define service {
  use                 devops-service
  hostgroup_name      devops-web
  service_description HTTP
  check_command       devops_http
}
define service {
  use                 devops-service
  hostgroup_name      devops-web
  service_description Disk Usage
  check_command       devops_disk
}
define service {
  use                 devops-service
  hostgroup_name      devops-web
  service_description CPU Load
  check_command       devops_load
}
define service {
  use                 devops-service
  hostgroup_name      devops-web
  service_description Apache Process
  check_command       devops_procs
}
